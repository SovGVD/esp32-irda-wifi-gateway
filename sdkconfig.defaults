# ESP-IDF configuration (PlatformIO generates sdkconfig.<env> from this file)

# Required by the Arduino core
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# ESP32-C3 SuperMini: 4 MB flash, DIO mode
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# PPP towards the Palm, routed and NATed onto Wi-Fi
CONFIG_LWIP_PPP_SUPPORT=y
# CONFIG_LWIP_PPP_ENABLE_IPV6 is not set
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# The USB port carries the HotSync byte stream: keep ESP-IDF log output off it
# (errors still go to UART0), as in the stock Arduino build
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# Same optimisation and stack sizes as the prebuilt Arduino SDK
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_ISR_STACKSIZE=2096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2304
